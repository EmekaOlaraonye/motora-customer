# Public origin of the site, used to build absolute canonical and og:url
# values. Falls back to the browser origin in development.
VITE_SITE_URL=https://motora.co.bw

# Which data source the app reads from.
#   mock  — bundled fixtures with simulated latency (default)
#   api   — the Motora backend (see ../Motora API)
VITE_DATA_SOURCE=mock

# Fraction of mock requests that should fail, for exercising error states.
# 0 disables failures; 0.2 fails roughly one request in five.
VITE_MOCK_FAILURE_RATE=0

# Backend base URL, used once VITE_DATA_SOURCE=api.
# Defaults to http://localhost:4000 when unset.
VITE_API_BASE_URL=http://localhost:4000

# Firebase — required only when a Firebase-backed repository set is added.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
